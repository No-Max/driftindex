{
  "name": "drift-index",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run build --workspace=packages/shared && npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:sync:series-logos": "npm run db:sync:series-logos --workspace=apps/api",
    "db:import:royal-ds": "npm run db:import:royal-ds --workspace=apps/api",
    "db:import:rds-gp": "npm run db:import:rds-gp --workspace=apps/api",
    "db:import:rds-gp:list": "npm run db:import:rds-gp:list --workspace=apps/api",
    "db:import:rds-gp:all": "npm run db:import:rds-gp:all --workspace=apps/api",
    "db:import:rds-almanac": "npm run db:import:rds-almanac --workspace=apps/api",
    "db:merge-almanac-pilots": "npm run db:merge-almanac-pilots --workspace=apps/api",
    "db:dedupe-pilots": "npm run db:dedupe-pilots --workspace=apps/api",
    "db:import:tandem-battles": "npm run db:import:tandem-battles --workspace=apps/api",
    "db:import:tandem-battles:all": "npm run db:import:tandem-battles --workspace=apps/api -- --all",
    "db:import:pilot-countries": "npm run db:import:pilot-countries --workspace=apps/api",
    "db:import:pilot-countries:all": "npm run db:import:pilot-countries:all --workspace=apps/api",
    "db:backfill:pilot-countries": "npm run db:backfill:pilot-countries --workspace=apps/api",
    "db:backfill:stage-coefficients": "npm run db:backfill:stage-coefficients --workspace=apps/api",
    "db:import:drift-masters": "npm run db:import:drift-masters --workspace=apps/api",
    "db:import:drift-masters:list": "npm run db:import:drift-masters:list --workspace=apps/api",
    "db:import:drift-masters:archive": "npm run db:import:drift-masters:archive --workspace=apps/api",
    "db:import:drift-masters:archive:all": "npm run db:import:drift-masters:archive:all --workspace=apps/api",
    "db:import:drift-masters:all": "npm run db:import:drift-masters:all --workspace=apps/api",
    "db:import:drift-masters:manual": "npm run db:import:drift-masters:manual --workspace=apps/api",
    "db:import:formula-drift": "npm run db:import:formula-drift --workspace=apps/api",
    "db:import:formula-drift:list": "npm run db:import:formula-drift:list --workspace=apps/api",
    "db:import:formula-drift:probe": "npm run db:import:formula-drift:probe --workspace=apps/api",
    "db:import:d1gp": "npm run db:import:d1gp --workspace=apps/api",
    "db:import:d1gp:list": "npm run db:import:d1gp:list --workspace=apps/api",
    "db:import:d1gp:all": "npm run db:import:d1gp:all --workspace=apps/api",
    "db:import:drift-kings": "npm run db:import:drift-kings --workspace=apps/api",
    "db:import:drift-kings:all": "npm run db:import:drift-kings:all --workspace=apps/api",
    "db:import:drift-kings:2026": "npm run db:import:drift-kings:2026 --workspace=apps/api",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run db:sync:series-logos && npm run db:import:royal-ds",
    "db:setup:local": "npm run db:setup",
    "db:setup:prod": "npm run db:migrate:deploy && npm run db:seed && npm run db:sync:series-logos && npm run db:import:royal-ds",
    "deploy:media": "rsync -avz storage/media/ driftindex:/opt/driftindex/storage/media/"
  }
}
