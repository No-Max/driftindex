{
  "name": "@drift-index/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:import:royal-ds": "tsx scripts/import-royal-ds.ts",
    "db:import:rds-gp": "tsx scripts/import-rds-gp.ts",
    "db:import:rds-gp:list": "tsx scripts/import-rds-gp.ts --list-seasons",
    "db:import:rds-gp:all": "tsx scripts/import-rds-gp.ts --all --skip-photos",
    "db:import:rds-almanac": "tsx scripts/import-rds-almanac.ts",
    "db:merge-almanac-pilots": "tsx scripts/merge-almanac-pilots.ts",
    "db:dedupe-pilots": "tsx scripts/dedupe-pilots.ts",
    "db:import:tandem-battles": "tsx scripts/import-tandem-battles.ts",
    "db:import:tandem-battles:all": "tsx scripts/import-tandem-battles.ts --all"
  },
  "dependencies": {
    "@drift-index/shared": "*",
    "@prisma/client": "^6.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
