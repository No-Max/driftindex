# Drift Index API — local development
# Copy: cp .env.example .env

NODE_ENV=development

# Same credentials as docker-compose.yml (port 5433 on host)
DATABASE_URL="postgresql://driftindex:driftindex@localhost:5433/driftindex"

PORT=5021
CORS_ORIGIN="http://localhost:5020"

# Media storage (repo root storage/media by default)
MEDIA_ROOT="../../storage/media"
MEDIA_PUBLIC_BASE="/media"
