# Drift Index API — local development (default: shared prod DB on VPS)
# Copy: cp .env.example .env

NODE_ENV=development

# Production PostgreSQL (same data as driftindex.pro)
DATABASE_URL="postgresql://driftindex:driftindex@178.172.236.133:5433/driftindex"

# Isolated local DB instead: postgresql://driftindex:driftindex@localhost:5433/driftindex
# Then run: npm run db:setup:local

PORT=5021
CORS_ORIGIN="http://localhost:5020"

# Used by importers / mirroring only; dev UI loads photos from prod via Vite proxy
MEDIA_ROOT="../../storage/media"
MEDIA_PUBLIC_BASE="/media"
