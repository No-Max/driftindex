generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  SCHEDULED
  FINISHED
  CANCELLED
}

enum DataStatus {
  UNVERIFIED
  VERIFIED
}

enum GridSource {
  QUAL
  POINTS
}

model Series {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  shortName     String?
  country       String?
  logoUrl       String?
  featuredOrder Int?
  defaultWeight Float              @default(1.0)
  seasons       Season[]
  weights       SeriesWeight[]
  names         SeriesName[]
  pilotPhotos   PilotSeriesPhoto[]
  pilotAliases  PilotSeriesAlias[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SeriesName {
  id        String   @id @default(cuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  yearFrom  Int?
  yearTo    Int?
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, name])
  @@index([seriesId, yearFrom, yearTo])
}

model SeriesWeight {
  id           String   @id @default(cuid())
  seriesId     String
  series       Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  year         Int
  weight       Float
  prestigeRank Int?
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([seriesId, year])
}

model Season {
  id            String   @id @default(cuid())
  seriesId      String
  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  year          Int
  nameEn        String?
  nameRu        String?
  sourceLabelEn String?
  sourceLabelRu String?
  sourceUrl     String?
  events        Event[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([seriesId, year])
}

model Event {
  id               String        @id @default(cuid())
  seasonId         String
  season           Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  trackId          String?
  track            Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
  slug             String
  roundNumber      Int
  name             String
  startsAt         DateTime?
  status           EventStatus   @default(SCHEDULED)
  gridActual       Int?
  gridReference    Int           @default(32)
  stageCoefficient Float?
  gridSource       GridSource?
  results          EventResult[]
  teamResults      EventTeamResult[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([seasonId, slug])
  @@index([trackId])
}

model Track {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  country     String?
  city        String?
  description String?
  /** Cover image for lists; first gallery photo when gallery exists. */
  photoUrl    String?
  sourceUrl   String?
  photos      TrackPhoto[]
  events      Event[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model TrackPhoto {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  photoUrl  String
  sourceUrl String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([trackId, sortOrder])
}

model Pilot {
  id             String             @id @default(cuid())
  slug           String             @unique
  firstName      String
  lastName       String
  country        String?
  number         Int?
  photoUrl       String?
  photoSourceUrl String?
  photoUpdatedAt DateTime?
  results        EventResult[]
  seriesPhotos   PilotSeriesPhoto[]
  seriesAliases  PilotSeriesAlias[]
  pollOptions    PollOption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PilotSeriesAlias {
  id        String   @id @default(cuid())
  pilotId   String
  pilot     Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name      String
  nameKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, name])
  @@index([seriesId, nameKey])
  @@index([pilotId])
}

model PilotSeriesPhoto {
  id             String    @id @default(cuid())
  pilotId        String
  pilot          Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  seriesId       String
  series         Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  photoUrl       String?
  photoSourceUrl String?
  photoUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([pilotId, seriesId])
}

model Team {
  id              String            @id @default(cuid())
  name            String
  results         EventResult[]
  eventResults    EventTeamResult[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model EventTeamResult {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  position  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, teamId])
  @@index([teamId])
}

model EventResult {
  id             String     @id @default(cuid())
  eventId        String
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pilotId        String
  pilot          Pilot      @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  number         Int?
  qualPosition   Int?
  qualPoints     Float?
  qualScore100   Float?
  tandemPosition Int?
  tandemBattles  Int?
  tandemWins     Int?
  points         Int        @default(0)
  indexPoints    Float?
  dataStatus     DataStatus @default(UNVERIFIED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([eventId, pilotId])
}

enum PollStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum PollType {
  PILOTS
  CARS
  SERIES
  TEAMS
  TRACKS
  DUEL
}

model User {
  id         String     @id @default(cuid())
  telegramId String     @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  pollVotes  PollVote[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Poll {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  status      PollStatus   @default(ACTIVE)
  type        PollType
  year        Int?
  sortOrder   Int          @default(0)
  options     PollOption[]
  votes       PollVote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, sortOrder])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int        @default(0)
  /// Optional link to a site entity (pilots poll / duel).
  pilotId   String?
  pilot     Pilot?     @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  /// Snapshot fields for UI (photo, series badges, DI rank, …).
  photoUrl  String?
  metaJson  Json?
  votes     PollVote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([pollId, sortOrder])
  @@index([pilotId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([pollId, userId])
  @@index([pollId, optionId])
}
