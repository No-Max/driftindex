# Drift Index API — production (VPS)
# Copy on server: cp .env.production.example .env

NODE_ENV=production

# In-memory API response cache (home / prestige / pilots base list).
# Enabled automatically when NODE_ENV=production. Set CACHE_ENABLED=false to disable.
# CACHE_ENABLED=true
# CACHE_TTL_MS=120000

# PostgreSQL from docker-compose on the same host
DATABASE_URL="postgresql://driftindex:driftindex@localhost:5433/driftindex"

PORT=5021
CORS_ORIGIN="https://driftindex.pro,https://www.driftindex.pro,http://driftindex.pro,http://www.driftindex.pro"

MEDIA_ROOT="/opt/driftindex/storage/media"
MEDIA_PUBLIC_BASE="/media"
