# Vite dev — /media tries this origin (VPS) first, then local API.

VITE_MEDIA_ORIGIN=https://driftindex.pro

# Telegram Login Widget (BotFather username without @)
# VITE_TELEGRAM_BOT_USERNAME=driftindex_bot

# Umami (optional). Leave empty to disable tracking in local/dev builds.
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=/stats/stats.js
